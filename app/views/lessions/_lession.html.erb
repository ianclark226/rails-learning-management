<div id="<%= dom_id lession %>" class="my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Title:</strong>
    <%= lession.title %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Description:</strong>
    <%= lession.description %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Paid:</strong>
    <%= lession.paid? ? "Yes" : "No" %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Course:</strong>
    <%= lession.course_id %>
  </div>
</div>
