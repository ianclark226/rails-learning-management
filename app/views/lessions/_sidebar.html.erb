<div class="w-full">
    <% course.lessions.order(:position).each do |lession| %>
        <% if lession.paid %>
            <div class="border p-6 hover:bg-gray-200">
                <div>
                    <%= icon('fa-solid', 'lock' , class: "mr-2 text-gray-600" ) %> <span class="font-light">
                            <%= lession.title %>
                        </span>
                </div>
            </div>
            <% else %>
                <%= link_to course_lession_path(course, lession) do %>
                    <div class="border p-6 hover:bg-gray-200 <%= @lession.id == lession.id ? 'bg-amaranth-100' : '' %>">
                        <span class="font-light">
                            <%= lession.title %>
                        </span>
                    </div>
                    <% end %>
                        <% end %>
                            <% end %>
</div>