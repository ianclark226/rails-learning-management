<div class="flex flex-col lg:pl-6">
    <div class="mt-6 lr:mt-0 flex justify-center items-center w-full">
        <div class="bg-white rounded-lg shadow-lg overflow-hidden w-full">
            <div class="bg-amaranth-500 p-4">
                <h2 class="text-white-50 text-2xl font-bold">Start Learning</h2>
            </div>
            <div class="p-4">
                <% if user_signed_in? %>
                <% if @completed_lessions&.any? %>
                  <% if @completed_lessions.count == @course.lessions.count %>
                    <p class="text-gray-700 text-base mb-4">
                      You have completed this course. Congrats!
                    </p>
                    <%= link_to "Watch Again", course_lession_path(@course, @course.first_lession), class: "bg-revolver-600 hover:bg-revolver-700 text-white-50 font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline w-full transition ease-in-out duration-150" %>
                  <% else %>
                  <p class="text-gray-700 text-base mb-4">
                      Continue the course and pick up where you left off
                    </p>
                    <%= link_to "Continue Course", course_lession_path(@course, @course.next_lession(current_user)), class: "bg-revolver-600 hover:bg-revolver-700 text-white-50 font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline w-full transition ease-in-out duration-150" %>
                  <% end %>
                <% else %>
                  <p class="text-gray-700 text-base mb-4">
                  Start the course and begin learning all about the world of web dev.
                  </p>
                  <%= link_to "Start Course", course_lession_path(@course, @course.first_lession), class: "bg-revolver-600 hover:bg-revolver-700 text-white-50 font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline w-full transition ease-in-out duration-150" %>
                <% end %> 
              <% else %>
                <p class="text-gray-700 text-base mb-4">
                Sign up for free today and start exploring the endless possibilities.
                </p>
                <%= link_to "Sign Up", new_user_registration_path, class: "bg-revolver-600 hover:bg-revolver-700 text-white-50 font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline w-full transition ease-in-out duration-150" %>
              <% end %>
                    
            </div>
        </div>
    </div>
    <div class="p-4">
        <% if user_signed_in? %>
            <p class="text-gray-700 text-base mb-4">
                Start the course and begin learning about web dev
            </p>
            <%= link_to "Start Course" , course_lession_path(@course, @course.first_lession),
                class: "bg-revovler-600 hover:bg-revolver-700 text-white-50 font-bold py-2 px-4 rounded focus:outline-none foocus:shadow-outline w-full transition ease-in-out duration-150"
                %>
                <% else %>
                    <p class="text-gray-700 text-base mb-4">
                        Sign up for free today and start exploring
                    </p>
                    <%= link_to "Sign Up" , new_user_registration_path,
                        class: "bg-revovler-600 hover:bg-revolver-700 text-white-50 font-bold py-2 px-4 rounded focus:outline-none foocus:shadow-outline w-full transition ease-in-out duration-150"
                        %>
                        <% end %>
    </div>
    <% if @course.paid %>
        <div class="mt-6 flex justify-center items-center w-full">
            <div class="bg-white rounded-lg shadow-lg overflow-hidden w-full">
                <div class="bg-amaranth-500 p-4">
                    <h2 class="text-white-50 text-2xl font-bold">Get more content</h2>
                </div>
                <div class="p-4">
                    <% if user_signed_in? %>
                        <p class="text-gray-700 text-base mb-4">
                            Unlock more content by purchasing the full course.
                        </p>
                        <%= form_tag checkouts_path(@course), method: :post, data: { turbo: false }, class: 'mt-4' do %>
                        <%= hidden_field_tag :course_id, @course.id %>
                        <%= hidden_field_tag :stripeEmail, current_user.email %>
                        <%= button_tag "Unlock Full Course", class: "bg-revolver-600 hover:bg-revolver-700 text-white-50 font-bold py-2 px-4 rounded focus:outline-none flcus:shadow-outline w-full transition ease-in-out duration-150" %>
                        <% end %>
                        <% else %>
                            <p class="text-gray-700 text-base mb-4">
                                Sign up for free today and start exploring
                            </p>
                            <%= link_to "Sign Up" , new_user_registration_path,
                                class: "bg-revovler-600 hover:bg-revolver-700 text-white-50 font-bold py-2 px-4 rounded focus:outline-none foocus:shadow-outline w-full transition ease-in-out duration-150"
                                %>

                                <% end %>
                </div>
            </div>
        </div>
        <% end %>
</div>
</div>

</div>