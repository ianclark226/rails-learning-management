<% content_for :title, "Showing course" %>

<div class="mx-auto w-full flex flex-col lg:flow-row pb-6">
  <div class="mx-auto w-full"></div>
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <% if @course.lessions.any? && @course.lessions.first.video.present? %>
  <%= video_tag @course.lessions.first.video, controls: true, class: "w-full rounded mb-6" %>
  <% end %>

  <div class="border p-6 rounded">
    <div class="flex justify-start items-center flex-wrap w-full mb-2">
      <% @course.categories.each do |category| %>
      <div class="bg-amaranth-100 text-amaranth-800 text-sm font-semibold mt-2 mr-2 px-2.5 py-0.5 rounded"><%= category.name %></div>
      <% end %>
    </div>
    <span><%= @course.lessions.count %> <%= "lesson".pluralize(@course.lessions.count) %></span>
  </div>

  <%= link_to "Back to courses", courses_path, class: "ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  </div>
</div>
